{
  "name": "facemix",
  "version": "1.6.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/audit-public.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs && vitest run tests/touch-controls.test.tsx tests/renderer-recovery.test.ts tests/render-worker.test.ts tests/inference-recovery.test.ts tests/library-face-flow.test.tsx",
    "models": "node scripts/prepare-models.mjs",
    "start": "node scripts/serve-browser.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.32",
    "delaunator": "5.0.1",
    "fflate": "0.8.2",
    "lucide-react": "0.468.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zustand": "5.0.3"
  },
  "devDependencies": {
    "@napi-rs/canvas": "0.1.100",
    "@testing-library/react": "16.2.0",
    "@types/delaunator": "5.0.3",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-react": "4.3.4",
    "fake-indexeddb": "6.0.0",
    "jsdom": "26.0.0",
    "typescript": "5.8.2",
    "vite": "6.2.6",
    "vitest": "3.1.1",
    "esbuild": "0.25.12"
  }
}
